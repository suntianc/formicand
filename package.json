{
  "name": "formicand",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "npm run build:base",
    "build:computer-use": "node scripts/build-computer-use.mjs",
    "test": "npm run build:full && node scripts/test.mjs",
    "ui": "npm run build && node scripts/start-dashboard.mjs",
    "desktop": "npm run build && node scripts/build-desktop-motion.mjs && node scripts/desktop-dev.mjs",
    "main-worker": "node scripts/formicand.mjs main-worker",
    "cli": "node scripts/formicand.mjs",
    "start": "node scripts/formicand.mjs start",
    "test:browser": "npm run build:full && playwright test",
    "test:perf": "playwright test --config playwright.perf.config.js",
    "check:extensions": "tsc -p tsconfig.extensions.json",
    "lint": "eslint src web desktop scripts .pi e2e --max-warnings=0",
    "desktop:pack": "npm run desktop:prepare && node scripts/package-desktop.mjs pack",
    "desktop:dist": "npm run desktop:prepare && node scripts/package-desktop.mjs dist",
    "test:desktop": "npm run build:full && node scripts/desktop-smoke.mjs",
    "format": "node scripts/format.mjs --write",
    "format:check": "node scripts/format.mjs",
    "format:check:all": "node scripts/format.mjs --all",
    "check": "npm run build:full && npm run lint && npm run check:extensions && npm run format:check && npm run check:docs && npm run check:source",
    "check:ci": "npm run build:cli && npm run lint && npm run check:extensions && npm run format:check && npm run check:docs && npm run check:source",
    "build:cli": "node scripts/build-cli.mjs",
    "build:web-assets": "node scripts/build-web-assets.mjs",
    "watch:web-assets": "node scripts/build-web-assets.mjs --watch",
    "cli:pack": "npm run build:cli && node scripts/package-cli.mjs",
    "doctor": "node scripts/formicand.mjs doctor",
    "init": "node scripts/formicand.mjs init",
    "test:release": "node scripts/test-release.mjs",
    "test:release:runner": "node --test test/release/runner.test.mjs",
    "desktop:install-dev": "npm run build && node scripts/build-desktop-motion.mjs && node scripts/desktop-dev.mjs --install",
    "verify": "node scripts/verify.mjs",
    "verify:full": "node scripts/verify.mjs --full",
    "test:unit": "node scripts/test.mjs --build",
    "check:docs": "node scripts/check-docs.mjs",
    "check:source": "node scripts/check-source.mjs",
    "build:full": "npm run build:base",
    "build:base": "npm run build:cli && npm run build:web-assets && node scripts/build-computer-use.mjs && node scripts/build-desktop-icon.mjs",
    "desktop:prepare": "node scripts/ensure-electron.mjs && npm run build:base && node scripts/build-desktop-motion.mjs",
    "release:local": "node scripts/release-local.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.15.6",
    "@types/pngjs": "6.0.5",
    "@types/sanitize-html": "^2.16.2",
    "electron": "45.2.3",
    "electron-builder": "^26.15.3",
    "esbuild": "0.28.2",
    "eslint": "^9.39.5",
    "globals": "17.12.0",
    "jszip": "^3.10.2",
    "katex": "0.19.0",
    "linkedom": "^0.18.13",
    "mermaid": "12.2.0",
    "png2icons": "2.0.1",
    "prettier": "^3.9.9",
    "resedit": "1.7.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "8.70.1"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.6.1",
    "@earendil-works/pi-ai": "1.6.1",
    "@earendil-works/pi-coding-agent": "1.6.1",
    "@jitl/quickjs-singlefile-browser-release-sync": "0.32.0",
    "@modelcontextprotocol/sdk": "1.31.0",
    "dompurify": "^3.4.17",
    "entities": "^8.1.0",
    "htmlparser2": "^12.0.0",
    "ignore": "7.0.8",
    "marked": "^18.1.1",
    "minimatch": "10.2.6",
    "pg": "8.23.1",
    "playwright-core": "1.63.0",
    "pngjs": "7.0.0",
    "quickjs-emscripten": "0.32.0",
    "sanitize-html": "^2.18.0",
    "typebox": "1.3.27",
    "undici": "8.13.1",
    "zod": "^4.6.5"
  },
  "main": "desktop/main.cjs",
  "description": "Formicand local multi-agent harness and task runtime",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/suntianc/formicand.git"
  },
  "bugs": {
    "url": "https://github.com/suntianc/formicand/issues"
  },
  "homepage": "https://github.com/suntianc/formicand#readme",
  "author": "Formicand contributors",
  "bin": {
    "formicand": "scripts/formicand.mjs"
  },
  "overrides": {
    "image-size": "2.0.4"
  },
  "license": "MIT",
  "optionalDependencies": {
    "@ff-labs/fff-node": "0.11.0"
  }
}
